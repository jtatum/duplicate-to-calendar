{
  "manifest_version": 3,
  "name": "Google Calendar Duplicate Events to Calendar",
  "version": "1.0.0",
  "description": "Copy Google Calendar events to a specific calendar with one click",

  "permissions": [
    "identity",
    "storage"
  ],

  "oauth2": {
    "client_id": "1084028741439-3jdvjashnrb28d2nr8ktk1b73h8iln25.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },

  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://calendar.google.com/*"
  ],

  "background": {
    "service_worker": "dist/background.js"
  },

  "content_scripts": [{
    "matches": ["https://calendar.google.com/*"],
    "js": ["dist/content.js"],
    "css": ["styles/content.css"]
  }],

  "options_page": "options/options.html",

  "action": {
    "default_title": "Calendar Duplicator Settings"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}